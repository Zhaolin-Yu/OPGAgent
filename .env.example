# LangSmith 追踪（便于在 LangSmith 控制台查找 trace）
# 复制为 .env 后填入真实值，或通过环境变量导出
# LangSmith 追踪默认开启，设置后 trace 会上报到 LangSmith；关闭请用 --no-langsmith

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=agent_v3_opg

# OpenAI（Agent 主 LLM）
OPENAI_API_KEY=your-openai-api-key

# Gemini（LLM Zoo 中 llm_zoo_google 使用；优先于 GOOGLE_API_KEY）
GEMINI_API_KEY=your-gemini-api-key

# 可选：工具服务若需覆盖，见 tools_config.yaml
# DASHSCOPE_API_KEY=...   # Qwen
# OPENAI_BASE_URL=...
